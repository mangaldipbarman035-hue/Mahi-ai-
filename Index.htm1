<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mahi AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101322;color:white;font-family:Arial}
header{padding:20px;background:#1b2035;font-size:25px;font-weight:bold;color:#b69aff}
main{max-width:700px;margin:auto;padding:15px}
#chat{height:72vh;overflow-y:auto;padding:10px}
.msg{padding:14px;margin:12px 0;border-radius:15px;white-space:pre-wrap;line-height:1.5}
.user{background:#5141a5;margin-left:35px}
.ai{background:#252d45;margin-right:35px}
.bottom{display:flex;gap:8px;padding:12px 0}
input{flex:1;min-width:0;padding:15px;background:#252d45;color:white;border:1px solid #555;border-radius:12px}
button{background:#8965ed;color:white;border:0;border-radius:12px;padding:14px}
</style>
</head>
<body>
<header>✨ Mahi AI</header>
<main>
<div id="chat">
<div class="msg ai">নমস্কার! আমি Mahi AI। 😊
আমাকে যেকোনো প্রশ্ন করতে পারো।</div>
</div>
<div class="bottom">
<input id="question" placeholder="এখানে প্রশ্ন লেখো...">
<button onclick="send()">Send</button>
</div>
</main>
<script>
function send(){
let input=document.getElementById("question");
let chat=document.getElementById("chat");
let q=input.value.trim();
if(!q)return;
let user=document.createElement("div");
user.className="msg user";
user.textContent=q;
chat.appendChild(user);
let ai=document.createElement("div");
ai.className="msg ai";
ai.textContent="Mahi AI-এর Gemini API এখনো সংযুক্ত করা হয়নি।";
chat.appendChild(ai);
input.value="";
chat.scrollTop=chat.scrollHeight;
}
</script>
</body>
</html>
